# Local development settings. Not automatically loaded by the binary.
# To apply: export each variable in Linux shell (or set in service EnvironmentFile securely).
KONJE_CAMERA=none
KONJE_UVC_DEVICE=/dev/video0
KONJE_SPEECH=off
# Must point to an absolute path to an executable Python worker script.
# KONJE_WORKER_PATH=/home/konje/KONJE/tools/recognition_worker.py
# KONJE_MODEL_ROOT=/home/konje/.local/share/konje-models
# KONJE_MODEL_PACK=approved_model_pack_name
# Default similarity policy is experimental/uncalibrated (0.60 / margin 0.10).